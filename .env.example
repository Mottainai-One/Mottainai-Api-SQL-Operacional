# PostgreSQL operacional
DB_URL=jdbc:postgresql://localhost:5432/mottainai
DB_USER=your_application_login_role
DB_PASSWORD=your_database_password

# Necessário somente com SPRING_PROFILES_ACTIVE=local
DB_APP_ROLE=your_application_login_role
DB_MIGRATION_USER=your_separate_migration_role
DB_MIGRATION_PASSWORD=your_migration_role_password

# JWT (Base64 with at least 32 bytes)
JWT_SECRET=replace_with_a_base64_secret
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Firebase Auth project used by the operational mobile app
FIREBASE_PROJECT_ID=your-firebase-project-id

# SMTP para recuperação de senha e convites
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=your_smtp_password
STAFF_PASSWORD_RESET_URL=http://localhost:3000/reset-password
