# PostgreSQL operacional
DB_URL=jdbc:postgresql://localhost:5432/mottainai
DB_USER=your_application_login_role
DB_PASSWORD=your_database_password

# JWT (Base64 with at least 32 bytes)
JWT_SECRET=replace_with_a_base64_secret
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Firebase Auth project used by the operational mobile app
FIREBASE_PROJECT_ID=your-firebase-project-id

# SMTP para convites de funcionários
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=your_smtp_password
STAFF_PASSWORD_RESET_URL=http://localhost:3000/reset-password

# Base64-encoded AES-256 key (32 bytes); never commit a real key.
STAFF_DATA_ENCRYPTION_KEY=replace_with_base64_32_byte_key
STAFF_DATA_KEY_VERSION=1
# Separate stable Base64 256-bit key used only to create indexed CPF lookup fingerprints.
STAFF_DATA_LOOKUP_KEY=replace_with_a_different_base64_32_byte_key
# On rotation, list retained prior keys as version:base64 pairs separated by commas.
# Example shape only: STAFF_DATA_DECRYPTION_KEYS=1:<previous_base64_key>
STAFF_DATA_DECRYPTION_KEYS=
